{
  "name": "moulinette",
  "version": "14.0.0",
  "description": "Moulinette Media Search",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "scripts/sort-translations.py && tsc && vite build",
    "watch": "scripts/sort-translations.py && tsc && vite build --watch",
    "check": "npm run format --workspace=quick-search && npm run lint --workspace=quick-search"
  },
  "devDependencies": {
    "fvtt-types": "npm:@league-of-foundry-developers/foundry-vtt-types@latest",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-scss": "^4.0.0",
    "sass": "^1.79.0",
    "typescript": "^5.6.3",
    "vite": "^7.1.6"
  },
  "dependencies": {
    "@types/jquery": "^3.5.30",
    "vue": "^3.5.21"
  },
  "workspaces": ["src/*"]
}
